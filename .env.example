# Configuration serveur uniquement. Ne jamais placer une clé dans VITE_*.
PORT=3001
HOST=127.0.0.1

# Limite API par adresse client, comprise entre 1 et 10000.
API_RATE_LIMIT_PER_MINUTE=120
# Vide sans reverse proxy. Liste de ses IP exactes réellement vues par socket,
# séparées par virgules (64 maximum, aucun CIDR).
# Le proxy doit remplacer X-Real-IP par l'adresse cliente qu'il observe.
TRUSTED_PROXY_IPS=

# Fournisseurs publics initiaux, sans garantie de disponibilité.
# HTTPS obligatoire sauf HTTP sur loopback local pour un nœud local.
BITCOIN_API_URL=https://mempool.space/api
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
