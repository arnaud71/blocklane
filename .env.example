# Configuration serveur uniquement. Ne jamais placer une clé dans VITE_*.
PORT=3001
HOST=127.0.0.1

# Limite API par adresse client, comprise entre 1 et 10000.
API_RATE_LIMIT_PER_MINUTE=120
# Vide sans reverse proxy. Liste de ses IP exactes réellement vues par socket,
# séparées par virgules (64 maximum, aucun CIDR).
# Le proxy doit remplacer X-Real-IP par l'adresse cliente qu'il observe.
TRUSTED_PROXY_IPS=

# Fournisseurs publics initiaux, sans garantie de disponibilité.
# HTTPS obligatoire sauf HTTP sur loopback local pour un nœud local.
BITCOIN_API_URL=https://mempool.space/api
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com

# Pool Bitcoin complet via RPC public ; vide pour garder seulement le repli mempool.space.
# Baseline complète puis identifiants réconciliés toutes les 30 s ; détails des nouveaux seulement.
# Resynchronisation complète toutes les 10 min ; plafond 32 Mio / 8 s par collecte.
BITCOIN_RPC_URL=https://bitcoin-rpc.publicnode.com

# Flux d’événements partagés côté serveur, uniquement pour les compteurs/groupes collectifs.
# WSS obligatoire, WS seulement sur loopback. Vide pour désactiver un flux.
# Sans ces variables, activés seulement si le fournisseur HTTP correspondant reste celui par défaut.
BITCOIN_EVENTS_WS_URL=wss://mempool.space/api/v1/ws
ETHEREUM_EVENTS_WS_URL=wss://ethereum-rpc.publicnode.com
