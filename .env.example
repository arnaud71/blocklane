# Server-side configuration only. Never place a key in VITE_*.
PORT=3001
HOST=127.0.0.1

# API limit per client address, between 1 and 10000.
API_RATE_LIMIT_PER_MINUTE=120
# Leave empty without a reverse proxy. Comma-separated exact proxy IPs as seen
# on the socket (64 maximum, no CIDR).
# The proxy must replace X-Real-IP with the client address it observes.
TRUSTED_PROXY_IPS=

# Initial public providers, without an availability guarantee.
# HTTPS required; HTTP is allowed only on loopback for a local node.
BITCOIN_API_URL=https://mempool.space/api
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com

# Bitcoin node candidate and complete-pool fallback via RPC; empty keeps mempool.space only.
# Full pool baseline, then identifier reconciliation every 30 s; new details only.
# Full pool resynchronization every 10 min; 32 MiB / 8 s limit per pool collection.
BITCOIN_RPC_URL=https://bitcoin-rpc.publicnode.com

# Shared server-side event streams for flow metrics and bounded Bitcoin arrival details.
# WSS required; WS only on loopback. Empty disables a stream.
# If unset, enabled only when the corresponding HTTP provider remains the default.
BITCOIN_EVENTS_WS_URL=wss://mempool.space/api/v1/ws
ETHEREUM_EVENTS_WS_URL=wss://ethereum-rpc.publicnode.com
